<%- include('../partials/header') %>
<%- include('../partials/nav') %>

<main class="container">
  <h2>Perfil</h2>
  <p>Sesión iniciada como <strong><%= user.username %></strong>.</p>
  <ul>
    <li>Email: <%= user.email %></li>
    <li>Rol: <%= user.role %></li>
  </ul>

  <h3>Avatar</h3>
  <% if (user.avatar_path) { %>
    <p><img src="<%= user.avatar_path %>" alt="avatar" class="avatar"></p>
  <% } else { %>
    <p class="hint">Aún no has subido un avatar.</p>
  <% } %>

  <% if (uploadError) { %>
    <p class="error"><%= uploadError %></p>
  <% } %>

  <form method="POST" action="/profile/avatar" enctype="multipart/form-data" class="form">
    <label>
      Imagen (.png, .jpg, .jpeg o .gif, máximo 2 MB)
      <input type="file" name="avatar" accept="image/png,image/jpeg,image/gif" required>
    </label>
    <button type="submit">Subir</button>
  </form>

  <p class="profile-logout"><a href="/logout">Cerrar sesión</a></p>
</main>

<%- include('../partials/footer') %>
